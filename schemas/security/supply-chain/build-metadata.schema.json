{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/supply-chain/build-metadata.schema.json",
  "title": "Build metadata",
  "type": "object",
  "required": ["schema_version", "source_repository", "repository_name", "source_commit", "controlled_timestamp", "application_version", "dockerfile_sha256", "dockerignore_sha256", "dependency_definition_sha256", "base_image_reference", "built_image_reference", "image_id", "image_digest", "target_platform", "builder", "dirty_worktree", "build_command_policy", "sbom_reference", "sbom_sha256", "container_scan_reference", "container_scan_sha256", "release_decision_reference", "release_decision_sha256", "release_decision_id", "release_decision", "publication_eligibility_reference", "publication_eligibility_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_repository": {"type": "string", "minLength": 1},
    "repository_name": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "controlled_timestamp": {"type": "string", "format": "date-time"},
    "application_version": {"type": "string"},
    "dockerfile_sha256": {"$ref": "#/$defs/sha256"},
    "dockerignore_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_definition_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_inputs": {"type": "array", "items": {"type": "string"}},
    "base_image_reference": {"type": "string", "minLength": 1},
    "built_image_reference": {"type": "string", "pattern": ":git-[a-f0-9]{40}$"},
    "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "target_platform": {"type": "string", "pattern": "^linux/(amd64|arm64)$"},
    "builder": {"type": "object", "required": ["docker_buildx"], "properties": {"docker_buildx": {"type": "string"}}, "additionalProperties": false},
    "dirty_worktree": {"type": "boolean"},
    "build_command_policy": {"type": "string", "minLength": 1},
    "sbom_reference": {"type": ["string", "null"]},
    "sbom_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "container_scan_reference": {"type": ["string", "null"]},
    "container_scan_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "release_decision_reference": {"type": ["string", "null"]},
    "release_decision_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "release_decision_id": {"type": ["string", "null"]},
    "release_decision": {"type": ["string", "null"], "enum": ["pass", "conditional_pass", "block", null]},
    "publication_eligibility_reference": {"type": "string"},
    "publication_eligibility_status": {"enum": ["pending", "eligible", "conditionally_eligible", "blocked"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "additionalProperties": false
}
