# These are placeholders, not deployable account configuration.
region = "<approved-region>"
availability_zones = ["<approved-az-a>", "<approved-az-b>"]
administrator_role_arns = ["<existing-platform-admin-role-arn>"]
artifact_repository_url = "<shared-artifact-stack-output>"
cost_center = "<approved-budget-owner>"
addon_versions = {
  vpc-cni = "<approved-version>"
  kube-proxy = "<approved-version>"
  coredns = "<approved-version>"
  eks-pod-identity-agent = "<approved-version>"
}
api_client_security_group_ids = [] # Additional operator clients only; the M5 runner SG is attached by the composition.
github_owner = "Ibraheemolasupogit"
github_repository = "devsecops-application-security-pipeline"
github_oidc_provider_arn = null # Separate-account default: create once here. If sharing an AWS account, pass the existing provider ARN.
github_connection_arn = null # Set only to the already-authorized CodeConnections GitHub App connection ARN.
