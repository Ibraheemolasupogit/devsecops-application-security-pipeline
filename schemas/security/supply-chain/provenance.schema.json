{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository-generated build provenance",
  "type": "object",
  "required": ["schema_version", "predicate_type", "source_repository", "source_commit", "build_metadata_reference", "build_metadata_sha256", "dockerfile_sha256", "dockerignore_sha256", "dependency_definition_sha256", "build_command_policy", "image_digest", "sbom_reference", "sbom_sha256", "container_scan_reference", "container_scan_sha256", "canonical_trivy_finding_ids", "release_decision_reference", "release_decision_sha256", "release_decision_id", "release_decision", "publication_eligibility_reference"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "predicate_type": {"type": "string"},
    "source_repository": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "build_metadata_reference": {"type": "string"},
    "build_metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dockerfile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dockerignore_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_definition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "build_command_policy": {"type": "string"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sbom_reference": {"type": "string"},
    "sbom_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "container_scan_reference": {"type": "string"},
    "container_scan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_trivy_finding_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "release_decision_reference": {"type": "string"},
    "release_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release_decision_id": {"type": "string"},
    "release_decision": {"enum": ["pass", "conditional_pass", "block"]},
    "publication_eligibility_reference": {"type": "string"}
  },
  "additionalProperties": false
}
