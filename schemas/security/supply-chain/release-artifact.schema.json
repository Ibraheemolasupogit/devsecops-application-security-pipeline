{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M7 release artifact contract",
  "type": "object",
  "required": ["schema_version", "source_commit", "image_repository", "source_image_tag", "local_digest", "published_digest", "ecr_repository_url", "sbom_reference", "provenance_reference", "container_scan_reference", "release_decision", "release_decision_id", "publication_decision", "build_timestamp", "verification_status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image_repository": {"type": "string"},
    "source_image_tag": {"type": "string", "pattern": ":git-[a-f0-9]{40}$"},
    "local_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "published_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "ecr_repository_url": {"type": ["string", "null"]},
    "sbom_reference": {"type": "string"},
    "provenance_reference": {"type": "string"},
    "container_scan_reference": {"type": "string"},
    "release_decision": {"enum": ["pass", "conditional_pass", "block"]},
    "release_decision_id": {"type": "string"},
    "publication_decision": {"enum": ["eligible", "conditionally_eligible", "blocked"]},
    "build_timestamp": {"type": "string", "format": "date-time"},
    "verification_status": {"enum": ["blocked", "locally_verified", "published_verified"]}
  },
  "additionalProperties": false
}
